DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_plan?schema=public"

# 短信 OTP：console（默认，仅打日志）| noop | webhook | aliyun_sms_auth（阿里云短信认证/号码认证 SendSmsVerifyCode）
# SMS_PROVIDER=console
# SMS_WEBHOOK_URL=https://your-sms-bridge.example/hook
# SMS_WEBHOOK_TIMEOUT_MS=10000
# 可选：JSON 对象，合并为请求头，例如 {"Authorization":"Bearer xxx"}
# SMS_WEBHOOK_HEADERS=
# 可选：设置后对 body 做 HMAC-SHA256，以十六进制放入 X-Sms-Signature: sha256=<hex>
# SMS_WEBHOOK_SECRET=

# --- 阿里云短信认证服务（号码认证 Dypnsapi，赠送签名+模板，个人可开通）---
# SMS_PROVIDER=aliyun_sms_auth
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=
# ALIYUN_DYPNS_REGION=cn-hangzhou
# 控制台「赠送签名」「赠送模板」的 SignName / TemplateCode（见 dypns 控制台模板配置页）
# ALIYUN_SMS_AUTH_SIGN_NAME=
# ALIYUN_SMS_AUTH_TEMPLATE_CODE=
# 与模板变量一致；默认占位由阿里云生成验证码：{"code":"##code##","min":"5"}
# ALIYUN_SMS_AUTH_TEMPLATE_PARAM={"code":"##code##","min":"5"}
# ALIYUN_SMS_AUTH_VALID_TIME_SECONDS=300
# ALIYUN_SMS_AUTH_CODE_LENGTH=6
# 若发送接口填写了方案名称，校验时必须一致
# ALIYUN_SMS_AUTH_SCHEME_NAME=

# 同一手机号每个自然日（服务器本地时区）发送 OTP 总次数上限；0 为不限制。未设置时生产建议 20；测试环境 NODE_ENV=test 未配置则默认不限制
# SMS_OTP_DAILY_LIMIT_PER_PHONE=20

# 生产若仍需邮箱密码访问演示普通用户（不推荐），设为 true；否则普通用户仅能通过 /auth/otp
# AUTH_DEMO_PASSWORD_USER=false

# 设为 true 时开放 POST /auth/admin/register（写入 AdminUser；生产务必保持未设置或 false）
# ADMIN_OPEN_REGISTER=true

# 可选：配置后「生成计划」前的 /plans/assistant 会调用 DeepSeek（勿把真实密钥提交到 Git）
# 必须复制本文件为同目录的 .env，或写在仓库根目录 ai-plan/.env；只编辑本示例文件不会生效。
# DEEPSEEK_API_KEY=
# DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_TIMEOUT_MS=120000
