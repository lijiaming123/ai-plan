generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 已定稿计划（生成期数据在 PlanGenerationDraft，确认后迁入本表）
model Plan {
  id               String        @id @default(cuid())
  userId           String
  goal             String
  deadline         DateTime
  requirement      String
  type             String
  currentVersion   Int           @default(1)
  confirmedVersion Int?
  stages                  PlanStage[]
  versions                PlanVersion[]
  scheduleSlotSubmissions PlanScheduleSlotSubmission[]
  scheduleSlotAppeals     PlanScheduleSlotAppeal[]
  createdAt               DateTime                     @default(now())
}

/// 已定稿计划下，按打卡时间槽提交的执行证明（文字 + 外链附件）
model PlanScheduleSlotSubmission {
  id          String                       @id @default(cuid())
  planId      String
  slotKey     String
  userId      String
  content     String                       @default("")
  status      String                       @default("submitted")
  createdAt   DateTime                     @default(now())
  plan        Plan                         @relation(fields: [planId], references: [id], onDelete: Cascade)
  attachments PlanScheduleSlotAttachment[]

  @@index([planId, slotKey])
  @@index([userId])
}

/// 打卡核验未通过时用户可发起申诉；open=申诉处理中，closed=已处理/已关闭
model PlanScheduleSlotAppeal {
  id        String   @id @default(cuid())
  planId    String
  slotKey   String
  userId    String
  content   String   @default("")
  status    String   @default("open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, userId])
  @@index([planId, slotKey, status])
}

model PlanScheduleSlotAttachment {
  id           String                     @id @default(cuid())
  submissionId String
  url          String
  fileName     String?
  kind         String                     @default("other")
  hash         String
  createdAt    DateTime                   @default(now())
  submission   PlanScheduleSlotSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

/// 仅用于「创建计划 / 多版本草稿」流程，定稿后删除，数据写入 Plan
model PlanGenerationDraft {
  id             String                       @id @default(cuid())
  userId         String
  goal           String
  deadline       DateTime
  requirement    String
  type           String
  currentVersion Int                          @default(1)
  createdAt      DateTime                     @default(now())
  stages         PlanGenerationDraftStage[]
  versions       PlanGenerationDraftVersion[]

  @@index([userId])
}

model PlanGenerationDraftVersion {
  id           String                @id @default(cuid())
  draftId      String
  version      Int
  requirement  String
  deadline     DateTime
  snapshot     Json
  schedule     Json?
  createdAt    DateTime              @default(now())
  draft        PlanGenerationDraft   @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@unique([draftId, version])
  @@index([draftId])
}

model PlanGenerationDraftStage {
  id        String              @id @default(cuid())
  draftId   String
  name      String
  sortOrder Int
  createdAt DateTime            @default(now())
  draft     PlanGenerationDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId])
}

model PlanVersion {
  id         String   @id @default(cuid())
  planId     String
  version    Int
  requirement String
  deadline   DateTime
  snapshot   Json
  /** 打卡表（按天/按周），与版本绑定；由 DeepSeek 生成并可被用户编辑覆盖 */
  schedule   Json?
  createdAt  DateTime @default(now())

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, version])
  @@index([planId])
}

model PlanStage {
  id        String   @id @default(cuid())
  planId    String
  name      String
  sortOrder Int
  createdAt DateTime @default(now())

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
}

model TaskSubmission {
  id        String             @id @default(cuid())
  taskId    String
  userId    String
  content   String
  status    String             @default("in_review")
  images    SubmissionImage[]
  createdAt DateTime           @default(now())

  @@index([taskId])
  @@index([userId])
}

model SubmissionImage {
  id            String          @id @default(cuid())
  submissionId   String
  url           String
  hash          String
  createdAt     DateTime        @default(now())

  submission TaskSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model RuleConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PresetTemplate {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  summary       String
  coverImageUrl String?
  category      String
  tags          String[]
  locale        String   @default("zh-CN")
  payload       Json
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@index([category])
}

model MarketTemplate {
  id               String   @id @default(cuid())
  authorId         String
  sourcePlanId     String?
  title            String
  summary          String
  category         String
  tags             String[]
  payload          Json
  status           String   @default("published")
  publishedAt      DateTime?
  likeCount        Int      @default(0)
  applicationCount Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  likes            MarketTemplateLike[]
  favorites        MarketTemplateFavorite[]

  @@index([status, publishedAt])
  @@index([category])
  @@index([authorId])
}

model MarketTemplateLike {
  id         String   @id @default(cuid())
  userId     String
  templateId String
  createdAt  DateTime @default(now())
  template   MarketTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([userId, templateId])
  @@index([templateId])
}

model MarketTemplateFavorite {
  id         String   @id @default(cuid())
  userId     String
  templateId String
  createdAt  DateTime @default(now())
  template   MarketTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([userId, templateId])
  @@index([templateId])
}

/// 打卡提醒等站内消息；dedupeKey 幂等防重复
model InAppNotification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  planId    String
  slotKey   String
  title     String
  body      String
  dedupeKey String   @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())
  payload   Json?

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
}

/// 用户打卡提醒时间；次日 0:00 起用 pending* + switchAt 切换
model UserNotificationSettings {
  userId                 String    @id
  timeZone               String    @default("Asia/Shanghai")
  /// 当前生效的本地 0:00 起第几分钟 0..1439，默认 20:00 = 1200
  remindAtMinutes        Int       @default(1200)
  pendingRemindAtMinutes Int?
  /// UTC 到达后合并 pending
  switchAt               DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}
