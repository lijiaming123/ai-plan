# 方式 A：前端直连 API（与 apps/api 实际端口一致，复制为 .env.local）
# VITE_API_BASE_URL=http://localhost:3000

# 方式 B：留空或未设置时，请求走「当前站点」相对路径 /plans、/auth，由 Vite 开发代理转发（见 vite.config.ts）
# API 端口非 3000 时设置：
VITE_API_PROXY_TARGET=http://192.168.0.18:4100

# 帮助页「反馈」mailto 收件人（可选，默认 support@ai-plan.dev）
# VITE_SUPPORT_EMAIL=your-team@example.com

# 法律文档：运营主体名称与地址（上线前务必配置真实主体信息）
# VITE_LEGAL_OPERATOR_NAME=某某科技有限公司
# VITE_LEGAL_OPERATOR_ADDRESS=上海市某某区某某路 1 号
# VITE_LEGAL_EFFECTIVE_DATE=2026-06-22

# 侧栏主导航：设为 false 或 0 可隐藏对应入口（默认可用；用于部署期「导航诚实性」或灰度）
# VITE_FEATURE_ARCHIVE=false
# VITE_FEATURE_INSIGHTS=false

# 会员：续费外链（个人主体阶段赞助/月付页）；留空则续费按钮不跳转
# VITE_PRO_RENEW_URL=https://example.com/sponsor
# VITE_PRO_HELP_ANCHOR=/help#pro-tier
# 仅演示包开启本机模拟专业版
# VITE_ENABLE_DEMO_TIER_TOGGLE=true
